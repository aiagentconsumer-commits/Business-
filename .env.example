# The HTTP port for the local handoff service.
PORT=3000

# Optional. Configure the same value as a Vapi Custom Credential with a Bearer token.
VAPI_WEBHOOK_TOKEN=replace-with-a-long-random-value

# Route by department name. Use Vapi-compatible number, SIP, or assistant destinations.
HANDOFF_DESTINATIONS_JSON={"sales":{"type":"number","number":"+15551234567"},"support":{"type":"assistant","assistantId":"replace-with-vapi-assistant-id"},"default":{"type":"sip","uri":"sip:agent@example.com"}}

# Used when the requested department is not present in HANDOFF_DESTINATIONS_JSON.
HANDOFF_FALLBACK_DESTINATION={"type":"number","number":"+15557654321"}

# Google Calendar OAuth settings. Grant the calendar scope to a user who can write to GOOGLE_CALENDAR_ID.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=replace-with-google-oauth-refresh-token
GOOGLE_CALENDAR_ID=primary

# Meta Conversions API settings. The adapter records a server-side Lead event after a qualified handoff.
META_PIXEL_ID=replace-with-meta-pixel-id
META_ACCESS_TOKEN=replace-with-meta-conversions-api-access-token
META_GRAPH_API_VERSION=v25.0

# Google Ads offline conversion settings. The refresh token needs the Google Ads OAuth scope.
GOOGLE_ADS_DEVELOPER_TOKEN=replace-with-google-ads-developer-token
GOOGLE_ADS_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_ADS_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_ADS_REFRESH_TOKEN=replace-with-google-oauth-refresh-token
GOOGLE_ADS_CUSTOMER_ID=replace-with-google-ads-customer-id-without-dashes
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CONVERSION_ACTION_ID=replace-with-upload-clicks-conversion-action-id
GOOGLE_ADS_API_VERSION=v25
